# Environment Configuration for Vishal's Portfolio AI Assistant

# ============================================
# Ollama Configuration
# ============================================

# Ollama API endpoint (local installation)
OLLAMA_API_BASE=http://localhost:11434

# ============================================
# Database Configuration (for Sessions + RAG)
# ============================================

# PostgreSQL connection URL for session storage and vector database
# Format: postgresql+asyncpg://user:password@host:port/database
# 
# Local development:
DATABASE_URL=postgresql+asyncpg://vishal_agent:vishal_agent_secret@localhost:5432/vishal_agent_sessions

# Production with docker-compose:
# DATABASE_URL=postgresql+asyncpg://vishal_agent:vishal_agent_secret@postgres:5432/vishal_agent_sessions

# ============================================
# RAG Configuration (Optional)
# ============================================

# Embedding model for vector search (default: all-MiniLM-L6-v2)
# Options:
#   - all-MiniLM-L6-v2 (384 dim, fast, good quality) - DEFAULT
#   - all-mpnet-base-v2 (768 dim, slower, better quality)
#   - multi-qa-MiniLM-L6-cos-v1 (384 dim, optimized for Q&A)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================
# Production Server Configuration
# ============================================

# Number of worker processes (for gunicorn)
WORKERS=4

# Request timeout in seconds
TIMEOUT=120

# ============================================
# Notes
# ============================================
# 
# RAG is OPTIONAL:
#   - If DATABASE_URL is set → RAG enabled (agent can search documents)
#   - If DATABASE_URL is NOT set → RAG disabled (agent works without it)
#
# Session Storage:
#   - If DATABASE_URL is set → Uses PostgreSQL (scalable, multi-worker)
#   - If DATABASE_URL is NOT set → Uses in-memory (single worker only)
#
